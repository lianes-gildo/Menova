# Exemplo de variáveis de ambiente para deploy/docker-compose.prod.yml
# Copie este ficheiro para .env e proteja com: chmod 600 .env

# Base de Dados PostgreSQL
MENOVA_DB_USER=menova_app
MENOVA_DB_PASSWORD=gerar_palavra_passe_forte_aleatoria_aqui

# Pepper de Criptografia de PIN
MENOVA_PIN_PEPPER=gerar_chave_aleatoria_longa_aqui_para_pepper

# Porta da aplicação (se diferente da padrão)
PORTA_HTTP=80
PORTA_HTTPS=443
