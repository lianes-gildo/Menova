@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Painel Inicial";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@ViewBag.RestauranteNome</h1>
        <div class="text-muted small">
            NUIT: <strong>@ViewBag.RestauranteNuit</strong> &middot; Fuso Horário: <strong>@ViewBag.FusoHorario (CAT)</strong> &middot; Moeda: <strong>@ViewBag.Moeda</strong>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (CurrentUser.TemPermissao(PermissoesCatalogo.ContasAbrir))
        {
            <a href="/pedidos" class="btn btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i> Nova Comanda
            </a>
        }
        @if (CurrentUser.TemPermissao(PermissoesCatalogo.CaixaAbrir) || CurrentUser.TemPermissao(PermissoesCatalogo.CaixaCobrar))
        {
            <a href="/caixa" class="btn btn-primary">
                <i class="bi bi-cash-stack me-1"></i> Gestão de Caixa
            </a>
        }
    </div>
</div>

<!-- Cartões de Resumo Operacional (KPI Cards) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="p-3 me-3 bg-light border text-primary" style="font-size: 1.5rem;">
                    <i class="bi bi-currency-exchange" style="color: var(--mv-vinho-700);"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Vendas de Hoje</div>
                    <div class="fs-4 fw-bold" style="color: var(--mv-vinho-900);">0,00 @ViewBag.Moeda</div>
                    <span class="badge badge-vinho">0 contas pagas</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="p-3 me-3 bg-light border text-primary" style="font-size: 1.5rem;">
                    <i class="bi bi-layout-wtf" style="color: var(--mv-vinho-700);"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Mesas Ocupadas</div>
                    <div class="fs-4 fw-bold" style="color: var(--mv-vinho-900);">0 / 0</div>
                    <span class="badge badge-sucesso">Salão disponível</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="p-3 me-3 bg-light border text-primary" style="font-size: 1.5rem;">
                    <i class="bi bi-fire" style="color: var(--mv-vinho-700);"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Pedidos na Cozinha</div>
                    <div class="fs-4 fw-bold" style="color: var(--mv-vinho-900);">0</div>
                    <span class="badge badge-aviso">Tempo médio: 0 min</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="p-3 me-3 bg-light border text-primary" style="font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill" style="color: var(--mv-vinho-700);"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Auditoria Criptográfica</div>
                    <div class="fs-4 fw-bold text-success">Íntegra</div>
                    <span class="badge badge-sucesso">Cadeia SHA-256 ativa</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detalhes do Sistema e Ambiente -->
<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Estado Operacional e Configurações Regionais</span>
                <span class="badge badge-sucesso">Online (100% Local)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted" style="width: 250px;">Localização & Fuso Horário</td>
                                <td>Moçambique &middot; <code>@ViewBag.FusoHorario</code> (Hora Oficial: <strong>@ViewBag.HoraLocal</strong>)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Moeda Oficial</td>
                                <td><strong>@ViewBag.Moeda</strong> (Metical Moçambicano, 2 casas decimais)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Regime de IVA</td>
                                <td>16,00% (Padrão Moçambique, isolamento fiscal ativo)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Funcionários Registados</td>
                                <td>@ViewBag.TotalUtilizadores ativos em @ViewBag.TotalPerfis perfis de acesso</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Segurança & Auditoria</td>
                                <td>PostgreSQL WORM triggers + SHA-256 tamper-evident chain</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Rede & Conectividade</td>
                                <td>Operação 100% offline em rede local sem dependência de internet</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                Atalhos Rápidos
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="/instalar-certificado" class="btn btn-outline-primary text-start">
                    <i class="bi bi-shield-check me-2"></i>Instalar Certificado SSL Local
                </a>
                <a href="/auditoria" class="btn btn-outline-primary text-start">
                    <i class="bi bi-journal-check me-2"></i>Verificar Integridade da Auditoria
                </a>
                <a href="/health/ready" target="_blank" class="btn btn-outline-primary text-start">
                    <i class="bi bi-heart-pulse me-2"></i>Diagnóstico de Saúde (/health/ready)
                </a>
            </div>
        </div>
    </div>
</div>
