@model List<Menova.Application.DTOs.ContaDto>
@using Menova.Application.Security
@inject Menova.Application.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Gestão de Pedidos e Contas";
    var totalValorAberto = Model.Sum(c => c.TotalLiquido);
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="mb-0 fw-bold" style="color: #6E1A33;"><i class="bi bi-receipt-cutoff me-2"></i>Contas e Comandas Abertas</h3>
        <p class="text-muted small mb-0">Controlo de consumo ativo por mesa e balcão.</p>
    </div>
    <div class="col-md-6 text-md-end mt-2 mt-md-0">
        <span class="badge bg-light text-dark border p-2 me-2">
            Total em Aberto: <strong class="fs-6 text-success">@totalValorAberto.ToString("N2") MT</strong>
        </span>
        <a href="/pedidos/nova-comanda" class="btn text-white py-2 px-3" style="background-color: #6E1A33;">
            <i class="bi bi-plus-circle me-1"></i>Nova Comanda
        </a>
    </div>
</div>

<div class="card border shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Conta</th>
                    <th>Mesa / Local</th>
                    <th>Abertura</th>
                    <th>Responsável</th>
                    <th class="text-center">Total Pedidos</th>
                    <th class="text-end">Total (MZN)</th>
                    <th class="text-end" style="width: 140px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-2 text-success d-block mb-2"></i>
                            Não existem contas ou comandas abertas no momento.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace fs-6">@c.Numero</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.MesaNumero))
                                {
                                    <span class="fw-bold fs-6" style="color: #6E1A33;"><i class="bi bi-grid-fill me-1"></i>Mesa @c.MesaNumero</span>
                                    <div class="small text-muted">@c.ZonaNome</div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-shop me-1"></i>Balcão</span>
                                }
                            </td>
                            <td>@c.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><i class="bi bi-person me-1"></i>@c.CriadoPor</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@c.Pedidos.Count comandas</span>
                            </td>
                            <td class="text-end fw-bold fs-6">@c.TotalLiquido.ToString("N2") MT</td>
                            <td class="text-end">
                                <a href="/pedidos/detalhes/@c.Id" class="btn btn-sm btn-outline-secondary me-1" title="Ver Detalhes">
                                    <i class="bi bi-eye"></i> Detalhes
                                </a>
                                <a href="/caixa/pagamento/@c.Id" class="btn btn-sm text-white" style="background-color: #6E1A33;" title="Liquidar Conta">
                                    <i class="bi bi-wallet2"></i> Cobrar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
