@inject ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Menova Restaurante</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Recursos 100% Locais (Sem CDN) -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#6E1A33" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="max-width: 100vw; overflow-x: hidden;">
    <div class="app-layout">
        <!-- Barra Superior Conectada no Topo (Logótipo Estável + Menu Dropdown + Horário) -->
        <header class="app-topbar" id="appTopbar">
            <div class="topbar-left d-flex align-items-center gap-2">
                <button class="btn-sidebar-toggle me-1" id="sidebarToggleBtn" title="Alternar barra lateral" type="button" aria-label="Alternar menu lateral">
                    <i class="bi bi-list fs-5" id="sidebarToggleIcon"></i>
                </button>

                <!-- Logótipo Menova (Div, NUNCA link - sistema e não site) -->
                <div class="topbar-brand user-select-none d-flex align-items-center" style="cursor: default; height: 38px; max-height: 38px; overflow: hidden;" title="Menova Restaurante">
                    <img src="~/menova_logo_0f.png" alt="Menova" class="topbar-brand-logo" style="height: 34px !important; max-height: 34px !important; width: auto !important; max-width: 140px !important; object-fit: contain !important; display: block !important;" />
                </div>

                <nav aria-label="breadcrumb" class="d-none d-lg-block border-start ps-3 ms-2">
                    <ol class="breadcrumb mb-0 py-0" style="font-size: 0.85rem;">
                        <li class="breadcrumb-item text-secondary fw-medium">Menova</li>
                        @if (ViewData["Title"] != null)
                        {
                            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
            </div>

            <div class="topbar-right">
                <!-- Relógio Local Maputo -->
                <div class="server-clock d-none d-sm-flex">
                    <i class="bi bi-clock"></i>
                    <span id="serverClockDisplay">--:--:--</span>
                </div>

                <!-- Perfil do Utilizador Autenticado -->
                <div class="dropdown">
                    <a class="user-profile-menu dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="~/default.jpg" alt="Foto de perfil" class="user-avatar" />
                        <div class="d-none d-md-flex flex-column text-start">
                            <span class="fw-semibold text-dark" style="font-size: 0.85rem;">@CurrentUser.NomeCompleto</span>
                            <span class="badge badge-vinho" style="font-size: 0.65rem;">@CurrentUser.PerfilCodigo</span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><h6 class="dropdown-header">Sessão: @CurrentUser.NomeUtilizador</h6></li>
                        @if (User.IsInRole(PerfisSistema.Garcom))
                        {
                            <li><a class="dropdown-item" href="/garcom"><i class="bi bi-phone me-2"></i>App Garçom</a></li>
                        }
                        @if (User.IsInRole(PerfisSistema.Caixa))
                        {
                            <li><a class="dropdown-item" href="/caixa"><i class="bi bi-cash-stack me-2"></i>Caixa &amp; Sessões</a></li>
                        }
                        @if (User.IsInRole(PerfisSistema.CozinhaBar))
                        {
                            <li><a class="dropdown-item" href="/kds"><i class="bi bi-fire me-2"></i>Cozinha / KDS</a></li>
                        }
                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.PainelVer))
                        {
                            <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-grid-1x2 me-2"></i>Painel Principal</a></li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Auth" asp-action="AlterarPalavraPasse">
                                <i class="bi bi-key me-2"></i>Alterar palavra-passe
                            </a>
                        </li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Terminar sessão
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Contentor Principal (Sidebar Vinho + Conteúdo) -->
        <div class="app-wrapper">
            <!-- Sidebar Esquerda (Recolhe SOMENTE o menu vinho, nunca a logo) -->
            <aside class="app-sidebar" id="appSidebar">
                <ul class="sidebar-menu">
                    <!-- 1. Categoria: Operação -->
                    <li class="sidebar-section-title">Operação</li>

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.PainelVer))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                            <a asp-controller="Dashboard" asp-action="Index" title="Painel Principal">
                                <i class="bi bi-grid-1x2-fill sidebar-icon"></i>
                                <span class="sidebar-text">Painel</span>
                            </a>
                        </li>
                    }

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.MesasVer))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mesas" ? "active" : "")">
                            <a href="/mesas" title="Salão e Mesas">
                                <i class="bi bi-layout-wtf sidebar-icon"></i>
                                <span class="sidebar-text">Salão &amp; Mesas</span>
                            </a>
                        </li>
                    }

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.ContasAbrir))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pedidos" ? "active" : "")">
                            <a href="/pedidos" title="Pedidos e Comandas">
                                <i class="bi bi-receipt-cutoff sidebar-icon"></i>
                                <span class="sidebar-text">Pedidos</span>
                            </a>
                        </li>
                    }

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.CozinhaVer))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Kds" ? "active" : "")">
                            <a href="/kds" title="Cozinha e Bar (KDS)">
                                <i class="bi bi-fire sidebar-icon"></i>
                                <span class="sidebar-text">Cozinha &amp; Bar</span>
                            </a>
                        </li>
                    }

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.CaixaAbrir) || CurrentUser.TemPermissao(PermissoesCatalogo.CaixaCobrar))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Caixa" ? "active" : "")">
                            <a href="/caixa" title="Caixa e Sessões">
                                <i class="bi bi-cash-stack sidebar-icon"></i>
                                <span class="sidebar-text">Caixa</span>
                            </a>
                        </li>
                    }

                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.ContasAbrir))
                    {
                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Garcom" ? "active" : "")">
                            <a href="/garcom" title="Terminal Garçom">
                                <i class="bi bi-phone-fill sidebar-icon"></i>
                                <span class="sidebar-text">Terminal Garçom</span>
                            </a>
                        </li>
                    }

                    <!-- 2. Categoria: Gestão -->
                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.MenuVer) || CurrentUser.TemPermissao(PermissoesCatalogo.RelatoriosVer))
                    {
                        <li class="sidebar-section-title">Gestão</li>

                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.MenuVer))
                        {
                            <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Menu" ? "active" : "")">
                                <a href="/menu" title="Menu e Artigos">
                                    <i class="bi bi-journal-bookmark-fill sidebar-icon"></i>
                                    <span class="sidebar-text">Menu &amp; Artigos</span>
                                </a>
                            </li>
                        }

                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.RelatoriosVer))
                        {
                            <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Relatorios" ? "active" : "")">
                                <a href="/relatorios" title="Relatórios e Vendas">
                                    <i class="bi bi-bar-chart-fill sidebar-icon"></i>
                                    <span class="sidebar-text">Relatórios</span>
                                </a>
                            </li>
                        }
                    }

                    <!-- 3. Categoria: Administração & Sistema -->
                    @if (CurrentUser.TemPermissao(PermissoesCatalogo.UtilizadoresVer) ||
                         CurrentUser.TemPermissao(PermissoesCatalogo.DefinicoesGerir) ||
                         CurrentUser.TemPermissao(PermissoesCatalogo.ImpressorasGerir) ||
                         CurrentUser.TemPermissao(PermissoesCatalogo.DispositivosGerir) ||
                         CurrentUser.TemPermissao(PermissoesCatalogo.AuditoriaVer) ||
                         CurrentUser.TemPermissao(PermissoesCatalogo.BackupsVer))
                    {
                        <li class="sidebar-section-title">Administração</li>

                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.UtilizadoresVer))
                        {
                            <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Utilizadores" ? "active" : "")">
                                <a href="/utilizadores" title="Gestão de Funcionários">
                                    <i class="bi bi-people-fill sidebar-icon"></i>
                                    <span class="sidebar-text">Funcionários</span>
                                </a>
                            </li>
                        }

                        var ctrlAtual = ViewContext.RouteData.Values["Controller"]?.ToString();
                        var ehPaginaSistema = ctrlAtual == "Definicoes" || ctrlAtual == "Impressoras" || ctrlAtual == "Dispositivos" || ctrlAtual == "Auditoria" || ctrlAtual == "Backups" || ctrlAtual == "App";

                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.DefinicoesGerir) ||
                             CurrentUser.TemPermissao(PermissoesCatalogo.ImpressorasGerir) ||
                             CurrentUser.TemPermissao(PermissoesCatalogo.DispositivosGerir) ||
                             CurrentUser.TemPermissao(PermissoesCatalogo.AuditoriaVer) ||
                             CurrentUser.TemPermissao(PermissoesCatalogo.BackupsVer))
                        {
                            <li class="sidebar-item sidebar-item-dropdown @(ehPaginaSistema ? "active open" : "")">
                                <a href="#submenuSistema" data-bs-toggle="collapse" role="button" aria-expanded="@(ehPaginaSistema ? "true" : "false")" class="d-flex justify-content-between align-items-center" title="Sistema e Configurações">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-gear-fill sidebar-icon"></i>
                                        <span class="sidebar-text">Sistema</span>
                                    </div>
                                    <i class="bi bi-chevron-down sidebar-chevron @(ehPaginaSistema ? "rotate" : "")"></i>
                                </a>
                                <div class="collapse @(ehPaginaSistema ? "show" : "")" id="submenuSistema">
                                    <ul class="sidebar-submenu">
                                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.DefinicoesGerir))
                                        {
                                            <li class="sidebar-subitem @(ctrlAtual == "Definicoes" ? "active" : "")">
                                                <a href="/definicoes"><i class="bi bi-sliders me-2"></i>Definições</a>
                                            </li>
                                        }
                                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.ImpressorasGerir))
                                        {
                                            <li class="sidebar-subitem @(ctrlAtual == "Impressoras" ? "active" : "")">
                                                <a href="/impressoras"><i class="bi bi-printer-fill me-2"></i>Impressoras</a>
                                            </li>
                                        }
                                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.DispositivosGerir))
                                        {
                                            <li class="sidebar-subitem @(ctrlAtual == "Dispositivos" ? "active" : "")">
                                                <a href="/dispositivos"><i class="bi bi-phone-fill me-2"></i>Dispositivos</a>
                                            </li>
                                        }
                                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.BackupsVer))
                                        {
                                            <li class="sidebar-subitem @(ctrlAtual == "Backups" ? "active" : "")">
                                                <a href="/backups"><i class="bi bi-database-check me-2"></i>Backups</a>
                                            </li>
                                        }
                                        @if (CurrentUser.TemPermissao(PermissoesCatalogo.AuditoriaVer))
                                        {
                                            <li class="sidebar-subitem @(ctrlAtual == "Auditoria" ? "active" : "")">
                                                <a href="/auditoria"><i class="bi bi-shield-check me-2"></i>Auditoria</a>
                                            </li>
                                        }
                                        <li class="sidebar-subitem @(ctrlAtual == "App" ? "active" : "")">
                                            <a href="/app"><i class="bi bi-qr-code-scan me-2"></i>Instalar Móvel</a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }
                    }
                </ul>
        </aside>

        <!-- Backdrop Móvel para fechar menu ao tocar fora -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Área Principal de Conteúdo -->
        <div class="app-main">
            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="py-2 px-4 bg-white border-top text-end" style="font-size: 0.75rem; color: var(--mv-texto-suave);">
                &copy; @DateTime.UtcNow.Year Menova Restaurante &bull; Sistema Integrado de Gestão
            </footer>
        </div>
    </div>
</div>

    <!-- Container de Notificações Toast Global -->
    <div id="menovaToastContainer" class="menova-toast-container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Sucesso"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["Aviso"] != null)
        {
            <div class="toast align-items-center text-dark bg-warning border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Aviso"]
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Erro"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
    </div>

    <!-- Modal Global de Confirmação Interno (Sem alerts nativos) -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-labelledby="globalConfirmModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="globalConfirmModalTitle">Confirmação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body" id="globalConfirmModalBody">
                    Tem a certeza que deseja efetuar esta operação?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="globalConfirmModalSubmit">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts 100% Locais -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
