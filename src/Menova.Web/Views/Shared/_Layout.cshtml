@inject ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Menova Restaurante</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Recursos 100% Locais (Sem CDN) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Esquerda -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                    <img src="~/menova_logo_0f.png" alt="Menova" class="sidebar-logo" />
                </a>
            </div>

            <ul class="sidebar-menu">
                <li class="sidebar-section-title">Operação</li>

                <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill sidebar-icon"></i>
                        <span class="sidebar-text">Painel</span>
                    </a>
                </li>

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.MesasVer))
                {
                    <li class="sidebar-item">
                        <a href="/mesas">
                            <i class="bi bi-layout-wtf sidebar-icon"></i>
                            <span class="sidebar-text">Salão e Mesas</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.ContasAbrir))
                {
                    <li class="sidebar-item">
                        <a href="/pedidos">
                            <i class="bi bi-receipt-cutoff sidebar-icon"></i>
                            <span class="sidebar-text">Pedidos</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.CozinhaVer))
                {
                    <li class="sidebar-item">
                        <a href="/kds">
                            <i class="bi bi-fire sidebar-icon"></i>
                            <span class="sidebar-text">Cozinha / Bar</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.CaixaAbrir) || CurrentUser.TemPermissao(PermissoesCatalogo.CaixaCobrar))
                {
                    <li class="sidebar-section-title">Caixa & Menu</li>

                    <li class="sidebar-item">
                        <a href="/caixa">
                            <i class="bi bi-cash-stack sidebar-icon"></i>
                            <span class="sidebar-text">Caixa & Sessões</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.MenuVer))
                {
                    <li class="sidebar-item">
                        <a href="/menu">
                            <i class="bi bi-journal-bookmark sidebar-icon"></i>
                            <span class="sidebar-text">Menu & Artigos</span>
                        </a>
                    </li>
                }

                <li class="sidebar-section-title">Administração</li>

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.RelatoriosVer))
                {
                    <li class="sidebar-item">
                        <a href="/relatorios">
                            <i class="bi bi-bar-chart-fill sidebar-icon"></i>
                            <span class="sidebar-text">Relatórios</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.UtilizadoresVer))
                {
                    <li class="sidebar-item">
                        <a href="/utilizadores">
                            <i class="bi bi-people-fill sidebar-icon"></i>
                            <span class="sidebar-text">Funcionários</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.DispositivosGerir))
                {
                    <li class="sidebar-item">
                        <a href="/dispositivos">
                            <i class="bi bi-phone-fill sidebar-icon"></i>
                            <span class="sidebar-text">Dispositivos</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.ImpressorasGerir))
                {
                    <li class="sidebar-item">
                        <a href="/impressoras">
                            <i class="bi bi-printer-fill sidebar-icon"></i>
                            <span class="sidebar-text">Impressoras</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.AuditoriaVer))
                {
                    <li class="sidebar-item">
                        <a href="/auditoria">
                            <i class="bi bi-shield-check sidebar-icon"></i>
                            <span class="sidebar-text">Auditoria</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.BackupsVer))
                {
                    <li class="sidebar-item">
                        <a href="/backups">
                            <i class="bi bi-database-check sidebar-icon"></i>
                            <span class="sidebar-text">Backups</span>
                        </a>
                    </li>
                }

                @if (CurrentUser.TemPermissao(PermissoesCatalogo.DefinicoesGerir))
                {
                    <li class="sidebar-item">
                        <a href="/definicoes">
                            <i class="bi bi-sliders sidebar-icon"></i>
                            <span class="sidebar-text">Definições</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- Área Principal -->
        <div class="app-main">
            <!-- Barra Superior -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Alternar barra lateral" type="button">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <nav aria-label="breadcrumb" class="d-none d-md-block">
                        <ol class="breadcrumb mb-0 py-0" style="font-size: 0.85rem;">
                            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Menova</a></li>
                            @if (ViewData["Title"] != null)
                            {
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                            }
                        </ol>
                    </nav>
                </div>

                <div class="topbar-right">
                    <!-- Relógio Fuso Moçambique (Africa/Maputo) -->
                    <div class="server-clock d-none d-sm-flex">
                        <i class="bi bi-clock"></i>
                        <span id="serverClockDisplay">--:--:-- (CAT)</span>
                    </div>

                    <!-- Perfil do Utilizador Autenticado -->
                    <div class="dropdown">
                        <a class="user-profile-menu dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/default.jpg" alt="Foto de perfil" class="user-avatar" />
                            <div class="d-none d-md-flex flex-column text-start">
                                <span class="fw-semibold text-dark" style="font-size: 0.85rem;">@CurrentUser.NomeCompleto</span>
                                <span class="badge badge-vinho" style="font-size: 0.65rem;">@CurrentUser.PerfilCodigo</span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">Sessão: @CurrentUser.NomeUtilizador</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Auth" asp-action="AlterarPalavraPasse">
                                    <i class="bi bi-key me-2"></i>Alterar palavra-passe
                                </a>
                            </li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Terminar sessão
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Conteúdo da Página -->
            <main class="app-content">
                @RenderBody()
            </main>

            <!-- Rodapé Discreto -->
            <footer class="py-2 px-4 bg-white border-top text-end" style="font-size: 0.75rem; color: var(--mv-texto-suave);">

            </footer>
        </div>
    </div>

    <!-- Container de Notificações Toast -->
    <div class="toast-container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Sucesso"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["Aviso"] != null)
        {
            <div class="toast align-items-center text-dark bg-warning border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Aviso"]
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Erro"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
    </div>

    <!-- Modal Global de Confirmação Interno (Sem alerts nativos) -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-labelledby="globalConfirmModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="globalConfirmModalTitle">Confirmação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body" id="globalConfirmModalBody">
                    Tem a certeza que deseja efetuar esta operação?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="globalConfirmModalSubmit">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts 100% Locais -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
