<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Menova Restaurante</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Recursos 100% Locais (Sem CDN) -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#6E1A33" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page" style="max-width: 100vw; overflow-x: hidden;">
    <div class="login-card">
        <div class="login-logo-container">
            <img src="~/menova_logo_0f.png" alt="Menova Restaurante" class="login-logo" style="max-height: 65px !important; width: auto !important; object-fit: contain !important;" />
        </div>
        
        @RenderBody()
    </div>

    <!-- Container Global de Notificações Toast -->
    <div id="menovaToastContainer" class="menova-toast-container"></div>

    <!-- Scripts 100% Locais -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
