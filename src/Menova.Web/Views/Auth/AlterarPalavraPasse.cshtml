@model Menova.Application.DTOs.AlterarPalavraPasseDto
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Alterar Palavra-passe";
}

<h4 class="text-center mb-3 fw-bold" style="color: var(--mv-vinho-900);">Alterar Palavra-passe</h4>
<p class="text-center text-muted small mb-4">Por segurança, introduza a palavra-passe atual e defina uma nova palavra-passe forte.</p>

<form asp-action="AlterarPalavraPasse" method="post">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger py-2 px-3 small mb-3">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage
        </div>
    }

    <div class="mb-3">
        <label asp-for="PalavraPasseAtual" class="form-label fw-semibold text-dark small">Palavra-passe atual</label>
        <input asp-for="PalavraPasseAtual" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" autofocus />
        <span asp-validation-for="PalavraPasseAtual" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NovaPalavraPasse" class="form-label fw-semibold text-dark small">Nova palavra-passe</label>
        <input asp-for="NovaPalavraPasse" type="password" class="form-control" placeholder="Mínimo 10 carateres (letras, números, símbolos)" autocomplete="new-password" />
        <span asp-validation-for="NovaPalavraPasse" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmarPalavraPasse" class="form-label fw-semibold text-dark small">Confirmar nova palavra-passe</label>
        <input asp-for="ConfirmarPalavraPasse" type="password" class="form-control" placeholder="Confirme a nova palavra-passe" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPalavraPasse" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="bi bi-check2-circle me-1"></i> Guardar Nova Palavra-passe
    </button>
</form>
