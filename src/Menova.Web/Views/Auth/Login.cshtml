@model Menova.Application.DTOs.LoginDto
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Iniciar Sessão";
    var modo = Context.Request.Query["modo"].ToString();
    var erroPin = TempData["ErroPin"]?.ToString();
    var isPinAtivo = modo == "pin" || !string.IsNullOrEmpty(erroPin);
}

<h4 class="text-center mb-1 fw-bold" style="color: var(--mv-vinho-900);">Acesso ao Sistema</h4>
<p class="text-center text-muted small mb-3">Selecione o método de autenticação:</p>

@if (!string.IsNullOrEmpty(ViewBag.AlertaMotivo as string))
{
    <div class="alert alert-warning py-2 px-3 small mb-3 border-0 shadow-sm d-flex align-items-center gap-2 text-start">
        <i class="bi bi-shield-exclamation text-warning fs-5 flex-shrink-0"></i>
        <div>@ViewBag.AlertaMotivo</div>
    </div>
}

<!-- Botão de Acesso Rápido por Biometria Nativa (Face ID / Impressão Digital) -->
<div id="blocoLoginBiometria" class="d-none mb-3">
    <div id="alertaErroBio" class="alert alert-danger py-2 px-3 small d-none mb-2"></div>
    <button type="button" id="btnAcessoBiometria" class="btn text-white w-100 py-3 fw-bold rounded-4 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #6E1A33 0%, #4a0f20 100%); font-size: 1.05rem;" onclick="iniciarLoginBiometria()">
        <i class="bi bi-fingerprint fs-4" id="iconBioLogin"></i>
        <span id="textBioLogin">Entrar com Face ID / Digital</span>
        <span id="spinnerBioLogin" class="spinner-border spinner-border-sm d-none" role="status"></span>
    </button>
    <div class="text-center mt-2 small text-muted">
        <span id="labelDispositivoBio">Dispositivo registado com autenticação biométrica</span>
    </div>
    <div class="d-flex align-items-center my-3">
        <hr class="flex-grow-1 my-0 text-muted opacity-25">
        <span class="px-2 text-muted small fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.5px;">OU ACEDA COM</span>
        <hr class="flex-grow-1 my-0 text-muted opacity-25">
    </div>
</div>

<!-- Abas de Seleção: Credenciais vs PIN -->
<ul class="nav nav-pills nav-fill mb-3 p-1 rounded-3 bg-light border" id="loginTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link py-1 small fw-semibold @(!isPinAtivo ? "active" : "")" id="tab-credenciais-btn" data-bs-toggle="pill" data-bs-target="#tab-credenciais" type="button" role="tab" aria-selected="@(!isPinAtivo ? "true" : "false")">
            <i class="bi bi-person-lock me-1"></i> Palavra-passe
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link py-1 small fw-semibold @(isPinAtivo ? "active" : "")" id="tab-pin-btn" data-bs-toggle="pill" data-bs-target="#tab-pin" type="button" role="tab" aria-selected="@(isPinAtivo ? "true" : "false")">
            <i class="bi bi-grid-3x3-gap-fill me-1"></i> PIN Rápido
        </button>
    </li>
</ul>

<div class="tab-content" id="loginTabsContent">
    <!-- ABA 1: Utilizador e Palavra-passe -->
    <div class="tab-pane fade @(!isPinAtivo ? "show active" : "")" id="tab-credenciais" role="tabpanel">
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 px-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage
                </div>
            }

            <div class="mb-3">
                <label asp-for="NomeUtilizador" class="form-label fw-semibold text-dark small">Nome de utilizador</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input asp-for="NomeUtilizador" class="form-control border-start-0" placeholder="Ex.: admin" autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="NomeUtilizador" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PalavraPasse" class="form-label fw-semibold text-dark small">Palavra-passe</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input asp-for="PalavraPasse" type="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="PalavraPasse" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMeCheck">
                    <label class="form-check-label small text-muted" for="lembrarMeCheck">
                        Lembrar sessão
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sessão
            </button>
        </form>
    </div>

    <!-- ABA 2: PIN Numérico (Garçom / Caixa / Operador) -->
    <div class="tab-pane fade @(isPinAtivo ? "show active" : "")" id="tab-pin" role="tabpanel">
        <form asp-controller="Auth" asp-action="LoginPin" method="post" id="formPin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <input type="hidden" name="tokenDispositivo" id="inputTokenDispositivo" value="" />

            @if (!string.IsNullOrEmpty(erroPin))
            {
                <div class="alert alert-danger py-2 px-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @erroPin
                </div>
            }

            <div class="text-center mb-3">
                <label for="inputPin" class="form-label fw-semibold text-dark small">Introduza o seu PIN de 4 dígitos</label>
                <input type="password" name="pin" id="inputPin" class="form-control form-control-lg text-center fw-bold fs-3 letter-spacing-lg mx-auto" 
                       style="max-width: 200px; letter-spacing: 0.5rem;" maxlength="8" inputmode="numeric" pattern="[0-9]*" placeholder="••••" required autocomplete="off" />
            </div>

            <!-- Teclado Numérico Tátil -->
            <div class="keypad-container mx-auto mb-3" style="max-width: 240px;">
                <div class="row g-2 mb-2">
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('1')">1</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('2')">2</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('3')">3</button></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('4')">4</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('5')">5</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('6')">6</button></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('7')">7</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('8')">8</button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('9')">9</button></div>
                </div>
                <div class="row g-2">
                    <div class="col-4"><button type="button" class="btn btn-outline-danger w-100 py-2 fw-semibold" onclick="limparPin()" title="Limpar"><i class="bi bi-backspace"></i></button></div>
                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-2 fs-5 fw-bold" onclick="adicionarDigito('0')">0</button></div>
                    <div class="col-4"><button type="submit" class="btn btn-success w-100 py-2 fw-semibold" title="Entrar"><i class="bi bi-check-lg"></i></button></div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Validar PIN
            </button>
        </form>
    </div>
</div>

<div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.75rem;">
    <span><i class="bi bi-clock me-1"></i>Horário de Maputo</span>
    <a href="/app" class="text-decoration-none text-muted fw-semibold">
        <i class="bi bi-phone me-1"></i>Instalar App Garçom
    </a>
</div>

@section Scripts {
    <script>
        function adicionarDigito(d) {
            var input = document.getElementById('inputPin');
            if (input && input.value.length < 8) {
                input.value += d;
                if (window.navigator && window.navigator.vibrate) {
                    window.navigator.vibrate(8);
                }
            }
        }

        function limparPin() {
            var input = document.getElementById('inputPin');
            if (input) {
                input.value = input.value.slice(0, -1);
            }
        }

        function base64ToBuffer(base64) {
            let str = base64.replace(/-/g, '+').replace(/_/g, '/');
            while (str.length % 4) {
                str += '=';
            }
            const binary = window.atob(str);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            return bytes.buffer;
        }

        // Reconhecimento de Biometria no Dispositivo
        document.addEventListener('DOMContentLoaded', function() {
            try {
                var token = localStorage.getItem('menova_device_token');
                if (token) {
                    var inputToken = document.getElementById('inputTokenDispositivo');
                    if (inputToken) inputToken.value = token;
                }

                var credId = localStorage.getItem('menova_biometria_cred_id');
                var dispositivoNome = localStorage.getItem('menova_biometria_dispositivo');
                if (credId && window.PublicKeyCredential) {
                    var bloco = document.getElementById('blocoLoginBiometria');
                    if (bloco) {
                        bloco.classList.remove('d-none');
                        if (dispositivoNome) {
                            var label = document.getElementById('labelDispositivoBio');
                            if (label) label.textContent = 'Autenticado para: ' + dispositivoNome;
                        }
                    }
                }
            } catch (e) {
                console.warn('Erro ao carregar credenciais locais:', e);
            }
        });

        // Iniciar Autenticação Biométrica Nativa (Face ID / Fingerprint)
        async function iniciarLoginBiometria() {
            const credId = localStorage.getItem('menova_biometria_cred_id');
            if (!credId || !window.PublicKeyCredential) return;

            const btn = document.getElementById('btnAcessoBiometria');
            const text = document.getElementById('textBioLogin');
            const icon = document.getElementById('iconBioLogin');
            const spinner = document.getElementById('spinnerBioLogin');

            btn.disabled = true;
            text.textContent = 'Aguardando validação...';
            icon.classList.add('d-none');
            spinner.classList.remove('d-none');

            try {
                // 1. Obter Desafio de Login do Servidor
                const respDesafio = await fetch('/auth/biometria/desafio', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (!respDesafio.ok) throw new Error('Não foi possível gerar desafio de segurança.');
                const dadosDesafio = await respDesafio.json();

                // 2. Chamar o Autenticador Nativo do Sistema Operativo (Face ID / Touch ID)
                const challengeBuffer = base64ToBuffer(dadosDesafio.challenge);
                const credIdBuffer = base64ToBuffer(credId);

                const assertion = await navigator.credentials.get({
                    publicKey: {
                        challenge: challengeBuffer,
                        allowCredentials: [{
                            id: credIdBuffer,
                            type: 'public-key',
                            transports: ['internal']
                        }],
                        userVerification: 'required',
                        timeout: 60000
                    }
                });

                if (!assertion) throw new Error('Autenticação biométrica cancelada.');

                // 3. Validar no Servidor e Iniciar Sessão
                const urlParams = new URLSearchParams(window.location.search);
                const returnUrl = urlParams.get('returnUrl') || '';

                const respAuth = await fetch('/auth/biometria/autenticar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        credentialId: credId,
                        returnUrl: returnUrl
                    })
                });

                const dataAuth = await respAuth.json();

                if (respAuth.ok && dataAuth.sucesso) {
                    text.textContent = 'Bem-vindo, ' + (dataAuth.nome || 'Colaborador') + '!';
                    setTimeout(() => {
                        window.location.href = dataAuth.redirecionarUrl || '/garcom';
                    }, 400);
                } else {
                    const elAlerta = document.getElementById('alertaErroBio');
                    if (elAlerta) {
                        elAlerta.textContent = dataAuth.mensagem || 'Falha na validação biométrica.';
                        elAlerta.classList.remove('d-none');
                    }
                }
            } catch (err) {
                console.warn('Erro no login biométrico:', err);
                if (err.name !== 'NotAllowedError') {
                    const elAlerta = document.getElementById('alertaErroBio');
                    if (elAlerta) {
                        elAlerta.textContent = 'Erro na leitura biométrica: ' + (err.message || 'Tente com o PIN ou Palavra-passe.');
                        elAlerta.classList.remove('d-none');
                    }
                }
            } finally {
                btn.disabled = false;
                text.textContent = 'Entrar com Face ID / Digital';
                icon.classList.remove('d-none');
                spinner.classList.add('d-none');
            }
        }
    </script>
}
