@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Pedido Inválido (400)";
}

<div class="text-center">
    <div class="display-1 fw-bold mb-2 text-warning">400</div>
    <h4 class="fw-bold mb-3" style="color: var(--mv-vinho-900);">Pedido Inválido</h4>
    <p class="text-muted small mb-4">
        O servidor não conseguiu processar o pedido devido a dados inválidos ou sessão expirada.
    </p>

    <div class="d-flex gap-2">
        <a href="javascript:history.back()" class="btn btn-secondary flex-fill">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary flex-fill">
            <i class="bi bi-house me-1"></i> Painel Inicial
        </a>
    </div>
</div>
