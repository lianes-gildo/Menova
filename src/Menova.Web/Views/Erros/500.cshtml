@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Erro Inesperado (500)";
}

<div class="text-center">
    <div class="display-1 fw-bold mb-2" style="color: var(--mv-erro);">500</div>
    <h4 class="fw-bold mb-3" style="color: var(--mv-vinho-900);">Ocorreu um Erro Inesperado</h4>
    <p class="text-muted small mb-4">
        O servidor encontrou uma anomalia interna ao processar o seu pedido.
    </p>

    <div class="alert alert-light border small text-muted mb-4 text-start">
        <i class="bi bi-shield-exclamation me-1"></i> O erro foi registado nos ficheiros de diagnóstico. Caso o problema persista, informe o suporte indicando o código abaixo:
        <div class="mt-2 text-xs">ID de Correlação: <code>@ViewBag.CorrelacaoId</code></div>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100">
            <i class="bi bi-arrow-clockwise me-1"></i> Recarregar Painel Inicial
        </a>
    </div>
</div>
