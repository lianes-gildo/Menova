@model Menova.Application.DTOs.PainelRelatoriosDto
@{
    ViewData["Title"] = "Centro de Exportação de Dados";
    var inicio = (DateTime)ViewBag.Inicio;
    var fim = (DateTime)ViewBag.Fim;
    var inicioStr = inicio.ToString("yyyy-MM-ddTHH:mm:ss");
    var fimStr = fim.ToString("yyyy-MM-ddTHH:mm:ss");
}

<div class="row mb-3 align-items-center">
    <div class="col-md-7">
        <h3 class="mb-0 fw-bold" style="color: #6E1A33;">
            <i class="bi bi-file-earmark-arrow-down-fill me-2"></i>Centro de Exportação de Dados e Relatórios
        </h3>
        <p class="text-muted small mb-0">
            Geração e descarga de ficheiros analíticos, extratos fiscais de IVA e relatórios operacionais em Excel, CSV e PDF.
        </p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <a href="/relatorios" class="btn btn-outline-secondary py-2 px-3">
            <i class="bi bi-arrow-left me-1"></i>Voltar ao Painel Geral
        </a>
    </div>
</div>

<!-- Filtros de Período e Navegação de Abas -->
<div class="card border shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" action="/relatorios/exportacao" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">Início:</span>
                    <input type="datetime-local" name="inicio" class="form-control" value="@inicio.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">Fim:</span>
                    <input type="datetime-local" name="fim" class="form-control" value="@fim.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm text-white flex-grow-1 fw-semibold" style="background-color: #6E1A33;">
                    <i class="bi bi-funnel me-1"></i>Filtrar Período
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Atalhos
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" href="/relatorios/exportacao?inicio=@DateTime.UtcNow.Date.ToString("yyyy-MM-ddTHH:mm:ss")&fim=@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss")">Hoje</a></li>
                        <li><a class="dropdown-item" href="/relatorios/exportacao?inicio=@DateTime.UtcNow.Date.AddDays(-1).ToString("yyyy-MM-ddTHH:mm:ss")&fim=@DateTime.UtcNow.Date.AddSeconds(-1).ToString("yyyy-MM-ddTHH:mm:ss")">Ontem</a></li>
                        <li><a class="dropdown-item" href="/relatorios/exportacao?inicio=@DateTime.UtcNow.Date.AddDays(-7).ToString("yyyy-MM-ddTHH:mm:ss")&fim=@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss")">Últimos 7 Dias</a></li>
                        <li><a class="dropdown-item" href="/relatorios/exportacao?inicio=@(new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1).ToString("yyyy-MM-ddTHH:mm:ss"))&fim=@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss")">Este Mês</a></li>
                    </ul>
                </div>
            </div>
        </form>
    </div>

    <!-- Sub-menu de Relatórios -->
    <div class="card-footer bg-light p-0 border-top">
        <ul class="nav nav-tabs border-bottom-0">
            <li class="nav-item">
                <a class="nav-link text-muted border-0" href="/relatorios?inicio=@inicioStr&fim=@fimStr">
                    <i class="bi bi-speedometer2 me-1"></i>Painel Executivo
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted border-0" href="/relatorios/artigos?inicio=@inicioStr&fim=@fimStr">
                    <i class="bi bi-pie-chart me-1"></i>Top Artigos &amp; Categorias
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted border-0" href="/relatorios/iva?inicio=@inicioStr&fim=@fimStr">
                    <i class="bi bi-percent me-1"></i>Resumo Fiscal de IVA
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted border-0" href="/relatorios/garcons?inicio=@inicioStr&fim=@fimStr">
                    <i class="bi bi-people me-1"></i>Desempenho de Garçons
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active fw-bold text-dark border-top-0 border-start-0 border-end-0" href="/relatorios/exportacao?inicio=@inicioStr&fim=@fimStr">
                    <i class="bi bi-file-earmark-arrow-down-fill me-1" style="color: #6E1A33;"></i>Exportação de Dados
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Resumo do Período Filtrado -->
<div class="alert alert-light border shadow-sm d-flex justify-content-between align-items-center py-2 px-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 text-danger fs-5" style="color: #6E1A33 !important;"></i>
        <div>
            <span class="small text-muted d-block">Intervalo de Exportação:</span>
            <strong class="text-dark">@inicio.ToString("dd/MM/yyyy HH:mm") &mdash; @fim.ToString("dd/MM/yyyy HH:mm")</strong>
        </div>
    </div>
    <div class="d-none d-md-flex align-items-center gap-3 text-end">
        <div>
            <span class="small text-muted d-block">Total de Vendas:</span>
            <strong class="text-success fs-6">@Model.Kpis.TotalFaturado.ToString("N2") MT</strong>
        </div>
        <div class="border-start ps-3">
            <span class="small text-muted d-block">Contas Liquidadas:</span>
            <strong class="text-dark fs-6">@Model.Kpis.TotalContasLiquidadas</strong>
        </div>
    </div>
</div>

<!-- Grelha de Tipos de Exportação Estruturada -->
<div class="row g-3">
    <!-- 1. Vendas Gerais & Faturação -->
    <div class="col-md-6 col-lg-6">
        <div class="card h-100 border shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <div class="p-2 rounded bg-success-subtle text-success">
                    <i class="bi bi-file-earmark-spreadsheet-fill fs-4"></i>
                </div>
                <div>
                    <h5 class="card-title mb-0 fw-bold text-dark">Mapa Geral de Vendas</h5>
                    <small class="text-muted">Extrato consolidado de faturação e liquidações</small>
                </div>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-secondary small flex-grow-1">
                    Contém todas as transações finalizadas no período, valores líquidos, métodos de cobrança utilizados (Numerário, POS/Cartão, M-Pesa, Emola), mesas atendidas e totais de IVA apurados.
                </p>
                <div class="p-2 bg-light rounded small mb-3 border">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    <strong>Compatibilidade:</strong> Microsoft Excel, Primavera BSS, PHC, Primavera Fiscal e auditoria contabilística moçambicana.
                </div>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <a href="/relatorios/exportar/excel?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-success fw-bold flex-grow-1 py-2">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel (.xlsx)
                    </a>
                    <a href="/relatorios/exportar/csv?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-secondary fw-bold flex-grow-1 py-2">
                        <i class="bi bi-file-earmark-text me-1"></i>CSV (UTF-8)
                    </a>
                    <a href="/relatorios/exportar/pdf?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm text-white fw-bold py-2 px-3" style="background-color: #6E1A33;">
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF Oficial
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Fiscalidade & Mapa de IVA (Moçambique 16%) -->
    <div class="col-md-6 col-lg-6">
        <div class="card h-100 border shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <div class="p-2 rounded bg-primary-subtle text-primary">
                    <i class="bi bi-percent fs-4"></i>
                </div>
                <div>
                    <h5 class="card-title mb-0 fw-bold text-dark">Apuramento Fiscal de IVA</h5>
                    <small class="text-muted">Bases de incidência, isenções e imposto liquidado</small>
                </div>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-secondary small flex-grow-1">
                    Documento contabilístico obrigatório para a Autoridade Tributária de Moçambique (AT). Especifica as bases tributáveis com taxa geral de IVA (16%), regimes de isenção e total de imposto cobrado.
                </p>
                <div class="p-2 bg-light rounded small mb-3 border">
                    <i class="bi bi-shield-check me-1 text-success"></i>
                    <strong>Conformidade Fiscal:</strong> Preparado conforme o Decreto n.º 28/2022 de IVA da República de Moçambique.
                </div>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <a href="/relatorios/exportar/iva-csv?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-primary fw-bold flex-grow-1 py-2">
                        <i class="bi bi-download me-1"></i>Descarregar CSV de IVA
                    </a>
                    <a href="/relatorios/exportar/excel?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-success fw-bold flex-grow-1 py-2">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel com Fórmulas
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Desempenho e Produtividade de Garçons -->
    <div class="col-md-6 col-lg-6">
        <div class="card h-100 border shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <div class="p-2 rounded bg-warning-subtle text-dark">
                    <i class="bi bi-people-fill fs-4 text-warning"></i>
                </div>
                <div>
                    <h5 class="card-title mb-0 fw-bold text-dark">Desempenho de Garçons &amp; Salão</h5>
                    <small class="text-muted">Produtividade individual, contas e ticket médio</small>
                </div>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-secondary small flex-grow-1">
                    Análise operacional por colaborador: número de mesas atendidas, volume bruto faturado, valor do ticket médio e percentual de participação nas vendas totais do restaurante.
                </p>
                <div class="p-2 bg-light rounded small mb-3 border">
                    <i class="bi bi-award me-1 text-warning"></i>
                    <strong>Uso:</strong> Avaliação de desempenho, cálculo de comissões e bonificações da equipa de salão.
                </div>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <a href="/relatorios/exportar/garcons-csv?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-warning text-dark fw-bold flex-grow-1 py-2">
                        <i class="bi bi-download me-1"></i>Descarregar Desempenho (CSV)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Consumo de Artigos & Análise Bar vs Cozinha -->
    <div class="col-md-6 col-lg-6">
        <div class="card h-100 border shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <div class="p-2 rounded bg-info-subtle text-info-emphasis">
                    <i class="bi bi-cup-straw fs-4"></i>
                </div>
                <div>
                    <h5 class="card-title mb-0 fw-bold text-dark">Vendas por Artigo &amp; Ementa</h5>
                    <small class="text-muted">Curva ABC de artigos, saídas de cozinha e bar</small>
                </div>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-secondary small flex-grow-1">
                    Ranking completo de consumo dos artigos do menu, volume em unidades, preço médio praticado, faturação por categoria e identificação de artigos de bar (bebidas rápidas) vs cozinha.
                </p>
                <div class="p-2 bg-light rounded small mb-3 border">
                    <i class="bi bi-box-seam me-1 text-info"></i>
                    <strong>Gestão de Stock:</strong> Suporte para planeamento de compras de bar e ingredientes de cozinha.
                </div>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <a href="/relatorios/exportar/csv?inicio=@inicioStr&fim=@fimStr" class="btn btn-sm btn-outline-info text-dark fw-bold flex-grow-1 py-2">
                        <i class="bi bi-download me-1"></i>Exportar Artigos &amp; Categorias (CSV)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
