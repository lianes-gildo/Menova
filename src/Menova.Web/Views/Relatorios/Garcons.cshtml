@model List<Menova.Application.DTOs.DesempenhoGarcomDto>
@{
    ViewData["Title"] = "Produtividade de Garçons";
    var inicio = (DateTime)ViewBag.Inicio;
    var fim = (DateTime)ViewBag.Fim;
    var totalGlobal = Model.Sum(g => g.TotalFaturado);
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="mb-0 fw-bold" style="color: #6E1A33;"><i class="bi bi-people me-2"></i>Desempenho da Equipa de Salão</h3>
        <p class="text-muted small mb-0">Controlo de produtividade por funcionário (pedidos atendidos e faturação gerada).</p>
    </div>
    <div class="col-md-6 text-md-end mt-2 mt-md-0">
        <a href="/relatorios?inicio=@inicio.ToString("yyyy-MM-ddTHH:mm:ss")&fim=@fim.ToString("yyyy-MM-ddTHH:mm:ss")" class="btn btn-outline-secondary py-2 px-3">
            <i class="bi bi-arrow-left me-1"></i>Voltar ao Painel
        </a>
    </div>
</div>

<div class="card border shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="small text-muted">Período: @inicio.AddHours(2).ToString("dd/MM/yyyy") até @fim.AddHours(2).ToString("dd/MM/yyyy")</span>
        <span class="badge bg-secondary">Total Salão: @totalGlobal.ToString("N2") MT</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tabelaRelatorioGarcons" data-paginate="10">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>Colaborador</th>
                    <th class="text-center">Pedidos Lançados</th>
                    <th class="text-end">Ticket Médio</th>
                    <th class="text-end">Total Faturado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            Sem registos de comandas fechadas para o período selecionado.
                        </td>
                    </tr>
                }
                else
                {
                    int pos = 1;
                    foreach (var g in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-muted">@pos</td>
                            <td class="fw-bold"><i class="bi bi-person-badge me-2"></i>@g.FuncionarioNome</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@g.TotalPedidos pedidos</span>
                            </td>
                            <td class="text-end text-muted">@g.TicketMedio.ToString("N2") MT</td>
                            <td class="text-end fw-bold" style="color: #6E1A33;">@g.TotalFaturado.ToString("N2") MT</td>
                        </tr>
                        pos++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
