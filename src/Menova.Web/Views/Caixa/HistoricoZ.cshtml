@model List<Menova.Application.DTOs.DocumentoZDto>
@{
    ViewData["Title"] = "Histórico de Fechos Z e Auditoria";
    var cadeiaValida = (bool)ViewBag.CadeiaValida;
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="mb-0 fw-bold" style="color: #6E1A33;"><i class="bi bi-shield-check me-2"></i>Histórico de Fechos Z</h3>
        <p class="text-muted small mb-0">Livro de apuramentos diários com verificação contínua da cadeia de hash SHA-256.</p>
    </div>
    <div class="col-md-6 text-md-end mt-2 mt-md-0">
        <a href="/caixa" class="btn btn-outline-secondary py-2 px-3">
            <i class="bi bi-arrow-left me-1"></i>Voltar ao Caixa
        </a>
    </div>
</div>

<!-- Estado da Integridade Criptográfica -->
<div class="alert @(cadeiaValida ? "alert-success" : "alert-danger") border-0 shadow-sm d-flex align-items-center py-3 mb-4">
    <div class="fs-2 me-3">
        <i class="bi @(cadeiaValida ? "bi-check-circle-fill" : "bi-exclamation-octagon-fill")"></i>
    </div>
    <div>
        <h5 class="fw-bold mb-0">
            @(cadeiaValida ? "Cadeia de Fechos Z Íntegra e Autêntica" : "ALERTA: Corrupção Detetada na Cadeia de Fechos Z!")
        </h5>
        <div class="small">
            @(cadeiaValida 
                ? "Todos os documentos registados na tabela WORM conferem perfeitamente com os hashes SHA-256 encadeados. Não foram detetadas alterações." 
                : "Foi detetada uma quebra no encadeamento criptográfico de um ou mais documentos. Por favor contacte o administrador do sistema.")
        </div>
    </div>
</div>

<div class="card border shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tabelaHistoricoZ" data-paginate="10">
            <thead class="table-light">
                <tr>
                    <th>N.º Z</th>
                    <th>Data / Hora</th>
                    <th>Caixa</th>
                    <th>Operador</th>
                    <th class="text-center">Documentos</th>
                    <th class="text-end">Total Líquido</th>
                    <th class="text-center">Integridade</th>
                    <th class="text-end" style="width: 120px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                            Ainda não foram emitidos talões Z no sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var z in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-dark fs-6 font-monospace">Z-@z.NumeroZ</span>
                            </td>
                            <td>@z.DataHora.AddHours(2).ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@z.CaixaNome (#@z.CaixaNumero)</td>
                            <td><i class="bi bi-person me-1"></i>@z.EmitidoPor</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@z.TotalDocumentosFaturados</span>
                            </td>
                            <td class="text-end fw-bold fs-6" style="color: #6E1A33;">
                                @z.TotalLiquido.ToString("N2") MT
                            </td>
                            <td class="text-center">
                                @if (z.HashValido)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Válido</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Corrompido</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/caixa/z/@z.Id" class="btn btn-sm btn-outline-secondary" title="Ver Documento">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
