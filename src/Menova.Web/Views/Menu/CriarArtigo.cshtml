@model Menova.Application.DTOs.CriarArtigoDto
@using Menova.Application.DTOs
@{
    ViewData["Title"] = "Novo Artigo";
    var categorias = (List<CategoriaDto>)ViewBag.Categorias;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a href="/menu" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Voltar</a>
            <h3 class="mb-0 fw-bold" style="color: #6E1A33;">Criar Novo Artigo</h3>
        </div>

        <div class="card border shadow-sm">
            <div class="card-body p-4">
                <form method="post" action="/menu/artigos/criar">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Código Interno *</label>
                            <input type="text" name="CodigoInterno" class="form-control" placeholder="Ex: PRT-005" required />
                            <small class="text-muted">Identificador único do artigo.</small>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-bold">Nome do Artigo *</label>
                            <input type="text" name="Nome" class="form-control" placeholder="Ex: Polvo Grelhado à Moçambicana" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Categoria *</label>
                            <select name="CategoriaId" class="form-select" required>
                                <option value="">-- Selecione uma Categoria --</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id">@c.Nome</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Preço de Venda (MZN) *</label>
                            <input type="number" step="0.01" name="Preco" class="form-control" placeholder="0.00" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Taxa IVA (%) *</label>
                            <input type="number" step="0.01" name="TaxaIva" class="form-control" value="16.00" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Tempo de Preparação (minutos)</label>
                            <input type="number" name="TempoPreparacaoMin" class="form-control" value="15" />
                        </div>

                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Destaque" value="true" id="checkDestaque">
                                <label class="form-check-label fw-bold" for="checkDestaque">
                                    Destacar no ecrã e menu ("Sugestão do Chefe")
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Descrição Curta</label>
                            <input type="text" name="DescricaoCurta" class="form-control" placeholder="Breve resumo visível na lista" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Descrição Detalhada / Ingredientes</label>
                            <textarea name="DescricaoLonga" rows="3" class="form-control" placeholder="Descrição completa exibida na comanda e detalhes"></textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="text-end">
                        <a href="/menu" class="btn btn-secondary me-2">Cancelar</a>
                        <button type="submit" class="btn text-white px-4" style="background-color: #6E1A33;">Guardar Artigo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
