@model Menova.Application.DTOs.AtualizarArtigoDto
@using Menova.Application.DTOs
@{
    ViewData["Title"] = "Editar Artigo";
    var categorias = (List<CategoriaDto>)ViewBag.Categorias;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a href="/menu" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Voltar</a>
            <h3 class="mb-0 fw-bold" style="color: #6E1A33;">Editar Artigo: @Model.Nome</h3>
        </div>

        <div class="card border shadow-sm">
            <div class="card-body p-4">
                <form method="post" action="/menu/artigos/editar/@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Código Interno *</label>
                            <input type="text" name="CodigoInterno" value="@Model.CodigoInterno" class="form-control" required />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-bold">Nome do Artigo *</label>
                            <input type="text" name="Nome" value="@Model.Nome" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Categoria *</label>
                            <select name="CategoriaId" class="form-select" required>
                                @foreach (var c in categorias)
                                {
                                    if (c.Id == Model.CategoriaId)
                                    {
                                        <option value="@c.Id" selected>@c.Nome</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">@c.Nome</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Preço de Venda (MZN) *</label>
                            <input type="number" step="0.01" name="Preco" value="@Model.Preco.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Taxa IVA (%) *</label>
                            <input type="number" step="0.01" name="TaxaIva" value="@Model.TaxaIva.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tempo de Preparação (minutos)</label>
                            <input type="number" name="TempoPreparacaoMin" value="@Model.TempoPreparacaoMin" class="form-control" />
                        </div>

                        <div class="col-md-4 d-flex align-items-center mt-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Destaque" value="true" id="checkDestaque" @(Model.Destaque ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="checkDestaque">
                                    Sugestão do Chefe (Destaque)
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center mt-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Ativo" value="true" id="checkAtivo" @(Model.Ativo ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="checkAtivo">
                                    Artigo Ativo no Sistema
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Descrição Curta</label>
                            <input type="text" name="DescricaoCurta" value="@Model.DescricaoCurta" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Descrição Detalhada / Ingredientes</label>
                            <textarea name="DescricaoLonga" rows="3" class="form-control">@Model.DescricaoLonga</textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="text-end">
                        <a href="/menu" class="btn btn-secondary me-2">Cancelar</a>
                        <button type="submit" class="btn text-white px-4" style="background-color: #6E1A33;">Guardar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
