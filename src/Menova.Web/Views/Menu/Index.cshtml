@model List<Menova.Application.DTOs.ArtigoDto>
@using Menova.Application.DTOs
@using Menova.Application.Security
@inject Menova.Application.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Menu e Artigos";
    var categorias = (List<CategoriaDto>)ViewBag.Categorias;
    Guid? categoriaSel = (Guid?)ViewBag.CategoriaSelecionada;
    string? pesquisa = (string?)ViewBag.Pesquisa;
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="mb-0 fw-bold" style="color: #6E1A33;"><i class="bi bi-journal-bookmark-fill me-2"></i>Gestão de Menu e Artigos</h3>
        <p class="text-muted small mb-0">Catálogo do restaurante, controlo de preços e disponibilidade imediata (Regra 86).</p>
    </div>
    <div class="col-md-6 text-md-end mt-2 mt-md-0">
        @if (CurrentUser.TemPermissao(PermissoesCatalogo.MenuGerir))
        {
            <a href="/menu/artigos/criar" class="btn text-white py-2 px-3" style="background-color: #6E1A33;">
                <i class="bi bi-plus-circle me-1"></i>Novo Artigo
            </a>
        }
    </div>
</div>

<!-- Filtros e Barra de Pesquisa -->
<div class="card mb-4 border shadow-sm">
    <div class="card-body p-3">
        <form method="get" action="/menu" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="pesquisa" value="@pesquisa" class="form-control" placeholder="Pesquisar por nome, código ou código de barras..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoriaId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todas as Categorias --</option>
                    @foreach (var c in categorias)
                    {
                        if (categoriaSel.HasValue && categoriaSel.Value == c.Id)
                        {
                            <option value="@c.Id" selected>@c.Nome (@c.TotalArtigos)</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Nome (@c.TotalArtigos)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 text-md-end">
                <button type="submit" class="btn btn-secondary px-3"><i class="bi bi-filter me-1"></i>Filtrar</button>
                @if (categoriaSel.HasValue || !string.IsNullOrEmpty(pesquisa))
                {
                    <a href="/menu" class="btn btn-outline-secondary ms-1">Limpar</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabela de Artigos -->
<div class="card border shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tabelaArtigos" data-paginate="10">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Código</th>
                    <th>Artigo</th>
                    <th>Categoria</th>
                    <th>Estação</th>
                    <th class="text-end">Preço (MZN)</th>
                    <th class="text-center">IVA</th>
                    <th class="text-center">Disponibilidade (86)</th>
                    <th class="text-end" style="width: 140px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Nenhum artigo encontrado com os critérios selecionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var artigo in Model)
                    {
                        <tr id="artigo-row-@artigo.Id">
                            <td><span class="badge bg-light text-dark border font-monospace">@artigo.CodigoInterno</span></td>
                            <td>
                                <div class="fw-bold">@artigo.Nome</div>
                                @if (!string.IsNullOrEmpty(artigo.DescricaoCurta))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@artigo.DescricaoCurta</div>
                                }
                            </td>
                            <td><span class="badge bg-light text-secondary border">@artigo.CategoriaNome</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(artigo.EstacaoNome))
                                {
                                    <span class="badge bg-secondary">@artigo.EstacaoNome</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@artigo.Preco.ToString("N2") MT</td>
                            <td class="text-center small text-muted">@artigo.TaxaIva.ToString("0")%</td>
                            <td class="text-center">
                                @if (CurrentUser.TemPermissao(PermissoesCatalogo.ArtigosEsgotar))
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-86 @(artigo.EsgotadoManual ? "btn-danger" : "btn-success")" 
                                            id="btn-86-@artigo.Id"
                                            onclick="alternar86('@artigo.Id', '@artigo.Nome')">
                                        <i class="bi @(artigo.EsgotadoManual ? "bi-x-circle-fill" : "bi-check-circle-fill") me-1"></i>
                                        <span id="label-86-@artigo.Id">@(artigo.EsgotadoManual ? "Esgotado (86)" : "Disponível")</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="badge @(artigo.EsgotadoManual ? "bg-danger" : "bg-success")">
                                        @(artigo.EsgotadoManual ? "Esgotado (86)" : "Disponível")
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (CurrentUser.TemPermissao(PermissoesCatalogo.MenuGerir))
                                {
                                    <a href="/menu/artigos/editar/@artigo.Id" class="btn btn-sm btn-outline-secondary me-1" title="Editar Artigo">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar Artigo" onclick="confirmarEliminarArtigo('@artigo.Id', '@artigo.Nome')">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    async function alternar86(artigoId, nomeArtigo) {
        const btn = document.getElementById('btn-86-' + artigoId);
        const label = document.getElementById('label-86-' + artigoId);
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        btn.disabled = true;

        try {
            const resp = await fetch(`/menu/artigos/${artigoId}/toggle-86`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ motivo: 'Alteração manual no painel de menu' })
            });

            const data = await resp.json();
            if (data.sucesso) {
                if (data.esgotadoManual) {
                    btn.className = 'btn btn-sm btn-86 btn-danger';
                    btn.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i><span id="label-86-${artigoId}">Esgotado (86)</span>`;
                } else {
                    btn.className = 'btn btn-sm btn-86 btn-success';
                    btn.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i><span id="label-86-${artigoId}">Disponível</span>`;
                }

                mostrarToast(data.mensagem || 'Disponibilidade atualizada com sucesso.', 'sucesso');
            } else {
                mostrarToast(data.mensagem || 'Erro ao processar alteração.', 'erro');
            }
        } catch (e) {
            console.error(e);
            mostrarToast('Erro de comunicação com o servidor local.', 'erro');
        } finally {
            btn.disabled = false;
        }
    }

    function confirmarEliminarArtigo(artigoId, nome) {
        const modal = new bootstrap.Modal(document.getElementById('globalConfirmModal'));
        document.getElementById('globalConfirmModalTitle').textContent = 'Eliminar Artigo';
        document.getElementById('globalConfirmModalBody').textContent = `Tem a certeza que deseja eliminar o artigo "${nome}"? Esta operação pode ser revertida por um administrador.`;
        
        const submitBtn = document.getElementById('globalConfirmModalSubmit');
        submitBtn.onclick = async function () {
            modal.hide();
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            try {
                const resp = await fetch(`/menu/artigos/eliminar/${artigoId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const res = await resp.json();
                if (res.sucesso) {
                    const row = document.getElementById('artigo-row-' + artigoId);
                    if (row) row.remove();
                    mostrarToast(res.mensagem);
                } else {
                    mostrarToast(res.mensagem);
                }
            } catch (err) {
                console.error(err);
            }
        };

        modal.show();
    }

    // Ouvir alterações em tempo real via SignalR
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof signalR !== "undefined") {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hub/menova")
                .withAutomaticReconnect()
                .build();

            connection.on("Artigo86Alterado", function (data) {
                const btn = document.getElementById("btn-86-" + data.artigoId);
                if (btn) {
                    if (data.esgotadoManual) {
                        btn.className = "btn btn-sm btn-86 btn-danger";
                        btn.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i><span>Esgotado (86)</span>`;
                    } else {
                        btn.className = "btn btn-sm btn-86 btn-success";
                        btn.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i><span>Disponível</span>`;
                    }
                }
            });

            connection.start().catch(err => console.error("Erro ao ligar ao SignalR:", err));
        }
    });
</script>
}
